CHATBOT_API_URL=http://127.0.0.1:8000/api/v1/chat/stream
NEXT_PUBLIC_CHATBOT_VOICE_WS_URL=ws://127.0.0.1:8000/api/v1/voice/realtime
# 局域网访问开发服务时，填写浏览器地址中的主机名或 IP，多个值用逗号分隔。
# CHATBOT_DEV_ORIGINS=192.168.13.163
# 可选：与 Python 服务 CHATBOT_MANAGEMENT_API_KEY 一致；仅在 Next.js 服务端使用，
# 用于向知识库管理 API 附加 X-Api-Key，浏览器不会收到该值。
# CHATBOT_MANAGEMENT_API_KEY=replace-with-management-secret
