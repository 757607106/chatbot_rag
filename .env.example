DASHSCOPE_API_KEY=replace-with-your-api-key
CHATBOT_MODEL=qwen-plus
CHATBOT_AGENT_NAME=rag_assistant
CHATBOT_EMBEDDING_MODEL=text-embedding-v4
CHATBOT_EMBEDDING_DIMENSIONS=1024
CHATBOT_RERANK_MODEL=qwen3-rerank
CHATBOT_RERANK_CANDIDATE_TOP_K=50
CHATBOT_DOCUMENTS_PATH=tests/docs_test
CHATBOT_MEDIA_PATH=.data/media
# 逗号分隔的远程图片主机白名单，同时支持 HTTP 和 HTTPS。
CHATBOT_REMOTE_IMAGE_HOSTS=alidocs.oss-cn-zhangjiakou.aliyuncs.com,yunhelp.gmgrasp.com.cn
CHATBOT_QDRANT_PATH=.data/qdrant
# 使用远程 Qdrant 时配置以下两项，并忽略本地路径。
# CHATBOT_QDRANT_URL=https://your-qdrant-service
# CHATBOT_QDRANT_API_KEY=replace-with-your-qdrant-api-key
CHATBOT_KNOWLEDGE_BASE_NAME=project_knowledge
CHATBOT_KNOWLEDGE_COLLECTION=project_knowledge
CHATBOT_CHUNK_SIZE=512
CHATBOT_CHUNK_OVERLAP=64
CHATBOT_RAG_TOP_K=5
# 语音识别（Qwen3-ASR-Flash，单个录音最大 10MB）。
CHATBOT_ASR_MODEL=qwen3-asr-flash
CHATBOT_ASR_LANGUAGE=zh
# 语音合成（qwen-audio-3.0-tts 单次文本上限 20000 字符）。
CHATBOT_TTS_MODEL=qwen-audio-3.0-tts-plus
CHATBOT_TTS_VOICE=longanlingxin
# 可选：覆盖百炼 TTS WebSocket 端点（dashscope 原生变量）。
# DASHSCOPE_WEBSOCKET_BASE_URL=wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# 可选：标准 mcpServers JSON，Header 直接填写最终值；enableTools 限制模型可见工具。
# CHATBOT_MCP_SERVERS_JSON={"mcpServers":{"yunprint-billing":{"type":"sse","url":"https://test-mcp-server.yuncyb.com/sse","headers":{"Authorization":"Bearer replace-with-current-token"},"enableTools":["listProducts","searchProducts","searchBillingReferences","previewSalesOrder","getSalesOrder","listSalesOrders"]}}}
